# ──────────────────────────────────────────────────────────────────
# n11-patika-final-case — backend (docker-compose) environment
# Bu dosya repoya commit'lenir. Gerçek değerler için kopyala:
#   cp .env.example .env
# `docker compose` bu dosyayı (.env) otomatik okur.
# ──────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_USER=caglar
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# ── Mongo (her servisin kendi DB'si var) ─────────────────────────
MONGODB_URI_USER=mongodb://mongo:27017/UserProfileDB
MONGODB_URI_PRODUCT=mongodb://mongo:27017/ProductDB
MONGODB_URI_BASKET=mongodb://mongo:27017/BasketDB

# ── JWT (auth-service) ───────────────────────────────────────────
JWT_SECRET=change-me-in-real-deploy-this-must-be-at-least-32-bytes-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=n11-bootcamp
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_INVITE_CODE=change-me

# ── Mail (notification-service) ──────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ── Iyzico (payment-service) — sandbox değerleri ─────────────────
# Prod'a geçerken Secret Manager / Cloud Run secret'larını kullan.
IYZICO_API_KEY=sandbox-6WzXl3t6CTSwQlQ5WWmvom7N64Wjo1tR
IYZICO_SECRET_KEY=sandbox-DbJPjQdBHRHTd3rpUCnAPqfzBcP6LeAh
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:9095/dev/v1/payment/iyzico/callback
IYZICO_SUCCESS_REDIRECT=http://localhost:3000/orders/{orderId}/result
IYZICO_FAILURE_REDIRECT=http://localhost:3000/orders/{orderId}/result
