# ─── Staging ortamı (Cloud Run) — sadece referans amaçlı ───────────
# Bu değerler runtime'da Secret Manager üzerinden inject edilir.
# Burada sadece anahtar isimleri görünür durumda olsun.

POSTGRES_USER=n11user
POSTGRES_PASSWORD=__set-via-secret-manager__
CLOUD_SQL_CONNECTION_NAME=__project:region:instance__

MONGODB_URI=__set-via-secret-manager__
REDIS_HOST=__set-via-secret-manager__
REDIS_PORT=6379

JWT_SECRET=__set-via-secret-manager__
ADMIN_PASSWORD=__set-via-secret-manager__
ADMIN_INVITE_CODE=__set-via-secret-manager__

# ── Iyzico ───────────────────────────────────────────────────────
IYZICO_API_KEY=__set-via-secret-manager__
IYZICO_SECRET_KEY=__set-via-secret-manager__
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=https://gateway-service-staging-c5kj6cslgq-ew.a.run.app/dev/v1/payment/iyzico/callback
IYZICO_SUCCESS_REDIRECT=https://staging.sepetify.com/orders/{orderId}/result
IYZICO_FAILURE_REDIRECT=https://staging.sepetify.com/orders/{orderId}/result
