# ─── Production ortamı (Cloud Run) — sadece referans amaçlı ────────
# Tüm sırlar runtime'da Secret Manager'dan gelir. Bu dosya sadece anahtar
# isimlerini ve sırlanmayan ayarları belgelemek için var.

POSTGRES_USER=n11user
POSTGRES_PASSWORD=__set-via-secret-manager__
CLOUD_SQL_CONNECTION_NAME=__project:region:instance__

MONGODB_URI=__set-via-secret-manager__
REDIS_HOST=__set-via-secret-manager__
REDIS_PORT=6379

JWT_SECRET=__set-via-secret-manager__
ADMIN_PASSWORD=__set-via-secret-manager__
ADMIN_INVITE_CODE=__set-via-secret-manager__

# ── Iyzico ───────────────────────────────────────────────────────
# Ödev kapsamı sandbox; gerçek prod'da merchant key + base-url değişecek.
IYZICO_API_KEY=__set-via-secret-manager__
IYZICO_SECRET_KEY=__set-via-secret-manager__
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=https://gateway-service-693501117153.europe-west1.run.app/dev/v1/payment/iyzico/callback
IYZICO_SUCCESS_REDIRECT=https://sepetify.com/orders/{orderId}/result
IYZICO_FAILURE_REDIRECT=https://sepetify.com/orders/{orderId}/result
